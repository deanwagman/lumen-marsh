APP_ENV=development
LOG_LEVEL=INFO

PARK_LATITUDE=28.474
PARK_LONGITUDE=-81.466
PARK_TIMEZONE=America/New_York

NWS_BASE_URL=https://api.weather.gov
NWS_USER_AGENT=LumenMarshEnvironmentalMonitor/0.1 (you@example.com)

OBSERVATION_POLL_SECONDS=300
ALERT_POLL_SECONDS=60
FORECAST_POLL_SECONDS=900
LOCATION_METADATA_REFRESH_SECONDS=86400

PROVIDER_TIMEOUT_SECONDS=10
PROVIDER_MAX_RETRIES=3

SIMULATION_ENABLED=true

VENUEOPS_BASE_URL=http://localhost:8080
OIDC_TOKEN_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPE=venueops/weather-recommendations.write
# Local development only. Production always requires OIDC credentials.
OIDC_DISABLED=true
# When using VenueOps LOCAL_JWT Compose mode, set this to local-weather-token.
VENUEOPS_BEARER_TOKEN=local-weather-token

DATABASE_URL=

# Fictional demonstration thresholds. These are not real park operating criteria.
WIND_GUST_HOLD_MPS=15.0
WIND_GUST_CLEAR_MPS=12.0
RAINFALL_HOLD_MM=10.0
RAINFALL_CLEAR_MM=5.0
LIGHTNING_HOLD_RADIUS_MILES=10.0
LIGHTNING_CLEARANCE_MINUTES=30
