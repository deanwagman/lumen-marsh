# Public browser configuration only. Never place credentials here.
# Vite exposes any VITE_* variable to the client bundle.
#
# Development: when copying this file to .env.development, leave this empty so
# the app calls same-origin /api and /media paths. Vite proxies those to Spring Boot.
# Production: set the VenueOps API origin, for example https://venueops.example.com
VITE_API_BASE_URL=

# Cognito public app client (authorization code + PKCE; never configure a client secret).
# Hosted-UI domain is not the OIDC authority. Authority is the issuer from tofu output.
VITE_AUTH_MODE=oidc
VITE_OIDC_AUTHORITY=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_EXAMPLE
VITE_OIDC_CLIENT_ID=examplepublicclientid
VITE_OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_OIDC_LOGOUT_URI=http://localhost:5173/
VITE_OIDC_SCOPES=openid profile email venueops/operator.read venueops/attractions.command venueops/incidents.command venueops/advisories.publish venueops/weather-recommendations.review venueops/maintenance.read venueops/maintenance.command venueops/maintenance.inspect

# Explicit development-only bypass:
# VITE_AUTH_MODE=local
