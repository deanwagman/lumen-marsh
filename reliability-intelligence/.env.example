APP_ENV=development
LOG_LEVEL=INFO
SIMULATION_ENABLED=true
SIMULATION_CYCLE_SECONDS=20
SIMULATION_SEED=20260920

VENUEOPS_BASE_URL=http://localhost:8080
VENUEOPS_TIMEOUT_SECONDS=10
VENUEOPS_MAX_RETRIES=3

OIDC_TOKEN_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPE=venueops/reliability.write
# Local development only. Production always requires OIDC credentials.
OIDC_DISABLED=true
# When using VenueOps LOCAL_JWT Compose mode, set this to local-reliability-token.
VENUEOPS_BEARER_TOKEN=local-reliability-token

ASSET_CODE=CC-TRAIN-01-WHEEL-A
SIGNAL_TYPE=VIBRATION
VIBRATION_VALUE=8.4
VIBRATION_UNIT=mm/s
