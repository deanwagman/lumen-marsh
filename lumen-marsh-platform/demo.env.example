# Copy to a protected file outside the repository, replace every change-me
# value, then pass it with: docker compose --env-file /path/to/demo.env ...
DEMO_HOST=demo.example.com
# Include DEMO_HTTPS_PORT in this origin when it is not 443. The gateway uses
# this exact value for HTTP redirects and all browser-facing URLs.
DEMO_ORIGIN=https://demo.example.com
DEMO_HTTP_PORT=80
DEMO_HTTPS_PORT=443

# LOCAL_JWT is suitable only for a short-lived, access-controlled reviewer
# sandbox. Set OIDC and provide the normal OIDC variables for a shared demo.
DEMO_SECURITY_MODE=LOCAL_JWT
DEMO_OIDC_DISABLED=true
DEMO_LEASE_DURATION=PT10M
DEMO_INACTIVITY_TIMEOUT=PT3M
DEMO_HARD_MAXIMUM=PT15M
DEMO_EXPIRY_SCAN=PT15S

# Generate independently, for example: openssl rand -hex 32
DEMO_RESET_SECRET=change-me-at-least-32-random-characters
DEMO_VENUEOPS_DB_PASSWORD=change-me
DEMO_ENVIRONMENTAL_DB_PASSWORD=change-me
# LOCAL_JWT fixture credentials. For OIDC, provide the deployment's service
# credentials through the standard OIDC_* / FLOW_OIDC_* / RELIABILITY_OIDC_*
# variables and leave no reusable browser token in this file.
DEMO_WEATHER_TOKEN=local-weather-token
DEMO_FLOW_TOKEN=local-flow-token
DEMO_RELIABILITY_TOKEN=local-reliability-token

NWS_USER_AGENT=LumenMarshDemo/1.0 (operator@example.com)
