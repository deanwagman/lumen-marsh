# Shared platform environment contract for local integration.
# Copy to .env and adjust. Never commit .env or credentials.
#
#   cp .env.example .env

# AWS CLI profile used by ./scripts/dev-up.sh --oidc to read the monitor secret.
AWS_PROFILE=lumen-marsh

# --- Public browser origins (host-facing) ---
GUEST_APP_ORIGIN=http://localhost:3000
OPERATOR_CONSOLE_ORIGIN=http://localhost:3001
VENUEOPS_PUBLIC_ORIGIN=http://localhost:8080
ENVIRONMENTAL_MONITOR_PUBLIC_ORIGIN=http://localhost:8000
PARK_FLOW_INTELLIGENCE_PUBLIC_ORIGIN=http://localhost:8100
RELIABILITY_INTELLIGENCE_PUBLIC_ORIGIN=http://localhost:8200

GUEST_APP_HOST_PORT=3000
OPERATOR_CONSOLE_HOST_PORT=3001
VENUEOPS_HOST_PORT=8080
ENVIRONMENTAL_MONITOR_HOST_PORT=8000
PARK_FLOW_INTELLIGENCE_HOST_PORT=8100
RELIABILITY_INTELLIGENCE_HOST_PORT=8200

# --- VenueOps API ---
VENUEOPS_IMAGE=venueops-api:local
VENUEOPS_SEED=true
VENUEOPS_DB_NAME=venueops
VENUEOPS_DB_USER=venueops
VENUEOPS_DB_PASSWORD=venueops
# LOCAL_JWT for offline Compose (see docs/security/local-development.md). Demo/prod: OIDC + Cognito issuer.
VENUEOPS_SECURITY_MODE=LOCAL_JWT
VENUEOPS_ISSUER_URI=http://venueops.local/test
# LOCAL_JWT fixture client ids. For Cognito, set to the console client id from print-cognito-local-env.sh.
VENUEOPS_ALLOWED_CLIENT_IDS=venueops-console-local,environmental-monitor-local,reliability-integration-local,park-flow-intelligence-local
VENUEOPS_CORS_ORIGINS=http://localhost:*,http://127.0.0.1:*
VENUEOPS_WEATHER_INGEST_RATE_LIMIT_PER_MINUTE=120

# --- Environmental Monitor ---
ENVIRONMENTAL_MONITOR_IMAGE=environmental-monitor:local
# compose.yaml defaults to false; compose.override.yaml enables true for local demos.
SIMULATION_ENABLED=false
NWS_USER_AGENT=LumenMarshEnvironmentalMonitor/0.1 (you@example.com)
PARK_LATITUDE=28.474
PARK_LONGITUDE=-81.466
PARK_TIMEZONE=America/New_York
# Inside Compose this must be the service hostname, never localhost.
VENUEOPS_BASE_URL=http://venueops-api:8080
# Cognito client credentials for demo/prod. Local override uses OIDC_DISABLED + VENUEOPS_BEARER_TOKEN.
OIDC_TOKEN_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPE=venueops/weather-recommendations.write
OIDC_DISABLED=true
VENUEOPS_BEARER_TOKEN=local-weather-token
ENVIRONMENTAL_DB_NAME=environmental_monitor
ENVIRONMENTAL_DB_USER=environmental
ENVIRONMENTAL_DB_PASSWORD=environmental

# --- Park Flow Intelligence ---
PARK_FLOW_INTELLIGENCE_IMAGE=park-flow-intelligence:local
PARK_FLOW_SIMULATION_ENABLED=false
FLOW_OIDC_TOKEN_URL=
FLOW_OIDC_CLIENT_ID=
FLOW_OIDC_CLIENT_SECRET=
FLOW_OIDC_SCOPE=venueops/flow-ingest.write
FLOW_OIDC_DISABLED=true
FLOW_VENUEOPS_BEARER_TOKEN=local-flow-token

# --- Reliability Intelligence ---
RELIABILITY_INTELLIGENCE_IMAGE=reliability-intelligence:local
RELIABILITY_SIMULATION_ENABLED=false
RELIABILITY_OIDC_TOKEN_URL=
RELIABILITY_OIDC_CLIENT_ID=
RELIABILITY_OIDC_CLIENT_SECRET=
RELIABILITY_OIDC_SCOPE=venueops/reliability.write
RELIABILITY_OIDC_DISABLED=true
RELIABILITY_VENUEOPS_BEARER_TOKEN=local-reliability-token

# --- Operator console (Vite build-time) ---
OPERATOR_CONSOLE_IMAGE=venueops-console:local
VITE_API_BASE_URL=http://localhost:8080
VITE_AUTH_MODE=local
# For Cognito login UX:
# VITE_AUTH_MODE=oidc
# VITE_OIDC_AUTHORITY=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_EXAMPLE
# VITE_OIDC_CLIENT_ID=
# VITE_OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
# VITE_OIDC_LOGOUT_URI=http://localhost:5173/
# VITE_OIDC_SCOPES=openid profile email venueops/operator.read venueops/attractions.command venueops/incidents.command venueops/advisories.publish venueops/weather-recommendations.review venueops/maintenance.read venueops/maintenance.command venueops/maintenance.inspect venueops/flow.read venueops/flow.command venueops/flow.publish

# --- Guest app ---
GUEST_APP_IMAGE=lumen-marsh-app:local
VENUEOPS_API_BASE_URL=http://localhost:8080

# Smoke/storm scripts (LOCAL_JWT bridge). For Cognito, export real access tokens.
OPERATOR_TOKEN=local-development-token
SUPERVISOR_TOKEN=local-development-token
OPERATOR_LIMITED_TOKEN=local-operator-token

# --- Image tagging helpers ---
IMAGE_TAG=local
GIT_SHA=dev
LOG_LEVEL=INFO
