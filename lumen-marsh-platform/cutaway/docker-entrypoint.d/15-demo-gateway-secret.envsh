#!/bin/sh
# Local Compose leaves DEMO_GATEWAY_SECRET unset. The nginx image substitutes
# only variables that already exist, so ${DEMO_GATEWAY_SECRET} would remain and
# nginx would exit on unknown variable "demo_gateway_secret". Export an empty
# value so the token is replaced. An empty header does not match the hosted
# gateway secret.
if [ -z "${DEMO_GATEWAY_SECRET+x}" ]; then
  export DEMO_GATEWAY_SECRET=
fi
