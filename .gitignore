.vscode/
*.iml
*.swp
*~

# Local environment and credentials
**/.env
**/.env.*
!**/.env.example
!**/.env.test
**/credentials.json
**/*.pem
**/*.key
**/*.p12
**/*.jks

# Logs, coverage, and temporary output
**/*.log
**/coverage/
**/htmlcov/
**/.coverage
**/tmp/
**/.cache/

# Java / Gradle
**/.gradle/
**/build/
!**/gradle/wrapper/gradle-wrapper.jar

# Python
**/.venv/
**/__pycache__/
**/*.py[cod]
**/*.egg-info/
**/.mypy_cache/
**/.pytest_cache/
**/.ruff_cache/
**/.tools/

# Node / Vite
**/node_modules/
**/dist/
**/dist-ssr/
**/*.local

# Flutter / Dart
**/.dart_tool/
**/.flutter-plugins-dependencies
