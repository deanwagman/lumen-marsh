APP_ENV=development
LOG_LEVEL=INFO
SIMULATION_ENABLED=true
SIMULATION_CYCLE_SECONDS=15
SIMULATION_SEED=20260915
WINDOW_SECONDS=60

VENUEOPS_BASE_URL=http://localhost:8080
VENUEOPS_TIMEOUT_SECONDS=10
VENUEOPS_MAX_RETRIES=3

OIDC_TOKEN_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPE=venueops/flow-ingest.write
# Local development only. Production always requires OIDC credentials.
OIDC_DISABLED=true
# When using VenueOps LOCAL_JWT Compose mode, set this to local-flow-token.
VENUEOPS_BEARER_TOKEN=local-flow-token

MANGROVE_RUN_ID=mangrove-run
CYPRESS_COIL_ID=cypress-coil
STORMGLASS_STATION_ID=stormglass-station
DISPLACED_DEMAND_FRACTION=0.80
CYPRESS_COIL_WEIGHT=0.50
STORMGLASS_STATION_WEIGHT=0.30
